# Copy to .env (ignored by Git). SQLite is the default.
SWITCHBOARD_BIND_IP=127.0.0.1
SWITCHBOARD_PORT=8080
SWITCHBOARD_PUBLIC_URL=
SWITCHBOARD_DOMAIN=
# Use distinct strong secrets. openssl rand -hex 32 produces URL-safe values.
SWITCHBOARD_CONTROL_TOKEN=
SWITCHBOARD_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# Existing external PostgreSQL; leave blank for SQLite or use the PG overlay.
SWITCHBOARD_DATABASE_URL=
SWITCHBOARD_LOG_LEVEL=info
SWITCHBOARD_REQUEST_TIMEOUT_SECONDS=600
SWITCHBOARD_LEASE_SECONDS=120
SWITCHBOARD_CHANNEL_STALE_SECONDS=90
SWITCHBOARD_RETENTION_DAYS=30
